{
  "name": "fondu",
  "version": "0.9.6",
  "description": "A small meta-framework for full-stack React apps, built on Hono and Vite. It runs on Bun, Cloudflare Workers and Node.",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "fondujs",
    "hono",
    "honojs",
    "nodejs",
    "react",
    "ssr",
    "vite"
  ],
  "homepage": "https://fondu.dev",
  "bugs": "https://github.com/fondujs/fondu/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fondujs/fondu.git",
    "directory": "packages/fondu"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/virtual.d.ts dist/",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@vitejs/plugin-react": "^6.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hono": "4.13.13",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "hono": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19"
  }
}
