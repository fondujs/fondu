{
  "route": {
    "scope": "typescript",
    "prefix": "/route",
    "description": "A page route: the loader renders the page named after this file",
    "body": [
      "import { defineHandler, render } from 'fondu'",
      "",
      "export const loader = defineHandler((c) => render(c, '${1:${TM_FILEPATH/^.*[\\\\/]app[\\\\/]routes[\\\\/](.+)\\.ts$/$1/}}'$2))",
      "$0",
    ],
  },
  "api": {
    "scope": "typescript",
    "prefix": "/api",
    "description": "An HTTP route: JSON in and out",
    "body": [
      "import { defineHandler } from 'fondu'",
      "",
      "export const GET = defineHandler((c) => c.json(${1:{ ok: true \\}}))",
      "",
      "export const POST = defineHandler(async (c) => {",
      "  const body = await c.req.json()",
      "  return c.json(body, 201)$0",
      "})",
    ],
  },
  "loader": {
    "scope": "typescript",
    "prefix": "/loader",
    "description": "GET: render a page",
    "body": ["export const loader = defineHandler((c) => render(c, '${1:page}'${2:, { \\}}))$0"],
  },
  "action": {
    "scope": "typescript",
    "prefix": "/action",
    "description": "POST: validated input, then back to the page",
    "body": [
      "export const action = defineHandler.withValidator({ body: ${1:schema} })((c, { body }) => {",
      "  $0",
      "  return back(c)",
      "})",
    ],
  },
  "actions": {
    "scope": "typescript",
    "prefix": "/actions",
    "description": "POST ?name: one of several form actions",
    "body": [
      "export const actions = {",
      "  ${1:name}: defineHandler((c) => {",
      "    $0",
      "    return back(c)",
      "  }),",
      "}",
    ],
  },
  "validated": {
    "scope": "typescript",
    "prefix": "/validated",
    "description": "A handler with validated body, query and params",
    "body": [
      "defineHandler.withValidator({ ${1:body}: ${2:schema} })((c, { ${1:body} }) => {",
      "  $0",
      "})",
    ],
  },
  "get": {
    "scope": "typescript",
    "prefix": "/get",
    "description": "GET: a plain HTTP handler",
    "body": ["export const GET = defineHandler((c) => {", "  $0", "  return c.json({})", "})"],
  },
  "post": {
    "scope": "typescript",
    "prefix": "/post",
    "description": "POST: a plain HTTP handler",
    "body": ["export const POST = defineHandler((c) => {", "  $0", "  return c.json({})", "})"],
  },
  "put": {
    "scope": "typescript",
    "prefix": "/put",
    "description": "PUT: a plain HTTP handler",
    "body": ["export const PUT = defineHandler((c) => {", "  $0", "  return c.json({})", "})"],
  },
  "patch": {
    "scope": "typescript",
    "prefix": "/patch",
    "description": "PATCH: a plain HTTP handler",
    "body": ["export const PATCH = defineHandler((c) => {", "  $0", "  return c.json({})", "})"],
  },
  "delete": {
    "scope": "typescript",
    "prefix": "/delete",
    "description": "DELETE: a plain HTTP handler",
    "body": ["export const DELETE = defineHandler((c) => {", "  $0", "  return c.json({})", "})"],
  },
  "middleware": {
    "scope": "typescript",
    "prefix": "/middleware",
    "description": "_middleware.ts: runs for this directory and below",
    "body": [
      "import { defineMiddleware } from 'fondu'",
      "",
      "export default defineMiddleware(async (c, next) => {",
      "  $0",
      "  await next()",
      "})",
    ],
  },
  "page": {
    "scope": "typescriptreact",
    "prefix": "/page",
    "description": "A page component: its parameter is the page's props",
    "body": [
      "import { Head } from '@inertiajs/react'",
      "",
      "export default function ${TM_FILENAME_BASE/[^a-zA-Z0-9]*([a-zA-Z0-9])([a-zA-Z0-9]*)/${1:/capitalize}${2}/g}({ ${1:title} }: { ${1:title}: ${2:string} }) {",
      "  return (",
      "    <>",
      "      <Head title={${1:title}} />",
      "      <h1>{${1:title}}</h1>",
      "      $0",
      "    </>",
      "  )",
      "}",
    ],
  },
  "layout": {
    "scope": "typescriptreact",
    "prefix": "/layout",
    "description": "A layout: pages/<directory>/_layout.tsx wraps the pages below it",
    "body": [
      "import type { ReactNode } from 'react'",
      "",
      "export default function Layout({ children }: { children: ReactNode }) {",
      "  return <main>{children}</main>$0",
      "}",
    ],
  },
  "form": {
    "scope": "typescriptreact",
    "prefix": "/form",
    "description": "Inertia <Form> posting to a route, with its errors",
    "body": [
      "<Form action={href('${1:/path}')} method=\"post\">",
      "  {({ errors, processing }) => (",
      "    <>",
      "      <input name=\"${2:name}\" aria-invalid={!!errors.${2:name}} />",
      "      {errors.${2:name} && <p>{errors.${2:name}}</p>}",
      "      <button disabled={processing}>${3:Save}</button>$0",
      "    </>",
      "  )}",
      "</Form>",
    ],
  },
}
