{
  "name": "example-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run db:migrate:local && vite",
    "build": "vite build",
    "preview": "bun run build && bun run db:migrate:local && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fondu-example --local",
    "db:migrate": "wrangler d1 migrations apply fondu-example --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@inertiajs/core": "3.9.1",
    "@inertiajs/react": "3.9.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "fondu": "workspace:*",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "puppeteer-core": "25.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
