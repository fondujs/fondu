{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fondu-site",
  "main": "./app/server.ts",
  "compatibility_date": "2026-10-01",
  // no *.workers.dev or preview URLs
  "routes": [
    {
      "pattern": "fondu.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
