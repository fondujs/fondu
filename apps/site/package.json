{
  "name": "site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./app/*"
  },
  "scripts": {
    "build": "vite build && pagefind --site dist/client",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite",
    "preview": "bun run build && vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fondu": "workspace:*",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/transformers": "4.5.0",
    "@stefanprobst/rehype-extract-toc": "3.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.5.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
