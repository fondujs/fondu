{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fondu-demo",
  "main": "./app/server.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  // no *.workers.dev or preview URLs: the fondu.dev zone is on the same account
  "routes": [
    {
      "pattern": "demo.fondu.dev",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 */6 * * *"],
  },
  // The first `wrangler deploy` creates the database and writes its id here (commit it); then `bun run db:migrate`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fondu-demo",
      "migrations_dir": "migrations",
      "database_id": "1bc3f487-f766-444d-9eba-31e17d8cb826",
    },
  ],
}
