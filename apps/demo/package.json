{
  "name": "demo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply fondu-demo --remote",
    "db:migrate:local": "wrangler d1 migrations apply fondu-demo --local",
    "deploy": "bun run build && wrangler deploy",
    "dev": "bun run db:migrate:local && vite",
    "e2e": "node e2e/run.mjs",
    "preview": "bun run build && bun run db:migrate:local && vite preview",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "better-auth": "1.7.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fondu": "workspace:*",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@inlang/paraglide-js": "2.29.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "puppeteer-core": "25.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
}
