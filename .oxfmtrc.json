{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "overrides": [
    {
      "files": ["apps/demo/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "./apps/demo/app/styles/app.css"
        }
      }
    },
    {
      "files": ["apps/site/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "./apps/site/app/styles/app.css"
        }
      }
    },
    {
      "files": ["apps/site/app/landing/**"],
      "options": {
        "printWidth": 72
      }
    }
  ],
  "ignorePatterns": ["**/worker-configuration.d.ts", "**/fondu.gen.d.ts", "**/migrations/**", "bun.lock"]
}
