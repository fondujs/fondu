{
  "name": "fondu-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter fondu build",
    "check": "bun fmt && bun lint && bun typecheck",
    "dev": "bun run --filter fondu dev",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "postinstall": "bun run build",
    "release": "bumpp packages/fondu/package.json -x \"bun install\"",
    "test": "bun run --filter fondu test",
    "typecheck": "bun run build && bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "bumpp": "12.3.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  }
}
