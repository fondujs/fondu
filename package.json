{
  "name": "fondu-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "bun run build",
    "build": "bun run --filter fondu build",
    "dev": "bun run --filter fondu dev",
    "test": "bun run --filter fondu test",
    "typecheck": "bun run build && bun run --filter '*' typecheck",
    "lint:any": "! grep -rnE \"(: any\\b|as any\\b|<any>|any\\[\\])\" packages/*/src apps --include=*.ts --include=*.tsx --exclude-dir=node_modules --exclude-dir=dist --exclude=worker-configuration.d.ts"
  }
}
